{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://municontrol.local/contracts/payroll-monthly-grh-summary.v1.json",
  "title": "Resumen mensual agregado de conceptos GRH",
  "description": "Salida local y sin registros personales de tres PDF Tipo de Liquidacion: Mes. La coincidencia es aritmetica; no certifica origen, liquidacion, cierre ni acreditacion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "parserVersion",
    "period",
    "status",
    "readyForReview",
    "reports",
    "crossReport",
    "normalizedRepartitionCode",
    "normalizedRepartitionMeaning",
    "normalizedOutputIncludesPersonalRecords",
    "acceptedRowsAggregateOnlyVerified",
    "rulesInferred",
    "provenanceVerified",
    "persistencePerformed",
    "payrollCalculated",
    "payrollPosted",
    "closeApproved",
    "bankAccreditationProven",
    "bankArtifactGenerated",
    "tribunalArtifactGenerated",
    "fiscalArtifactGenerated"
  ],
  "properties": {
    "contractVersion": { "const": "payroll-monthly-grh-summary.v1" },
    "parserVersion": { "const": "grh-concept-statistics-pdf-layout.v1" },
    "period": { "type": "string", "pattern": "^(19|20)[0-9]{2}-(0[1-9]|1[0-2])$" },
    "status": { "const": "matched" },
    "readyForReview": { "const": true },
    "reports": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/report" },
            { "properties": { "kind": { "const": "42" }, "jurisdiction": { "const": "42" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/report" },
            { "properties": { "kind": { "const": "55" }, "jurisdiction": { "const": "55" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/report" },
            { "properties": { "kind": { "const": "general" }, "jurisdiction": { "const": null } } }
          ]
        }
      ],
      "items": false
    },
    "crossReport": { "$ref": "#/$defs/crossReport" },
    "normalizedRepartitionCode": { "const": "0" },
    "normalizedRepartitionMeaning": { "const": "todas_las_reparticiones_del_pdf" },
    "normalizedOutputIncludesPersonalRecords": { "const": false },
    "acceptedRowsAggregateOnlyVerified": { "const": true },
    "rulesInferred": { "const": false },
    "provenanceVerified": { "const": false },
    "persistencePerformed": { "const": false },
    "payrollCalculated": { "const": false },
    "payrollPosted": { "const": false },
    "closeApproved": { "const": false },
    "bankAccreditationProven": { "const": false },
    "bankArtifactGenerated": { "const": false },
    "tribunalArtifactGenerated": { "const": false },
    "fiscalArtifactGenerated": { "const": false }
  },
  "$defs": {
    "int64String": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,18})$"
    },
    "nonNegativeInt64String": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "positiveInt32String": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
    },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conceptCode",
        "occurrences",
        "quantityHundredths",
        "remunerativeCents",
        "nonRemunerativeCents",
        "familyAllowancesCents",
        "retentionsCents",
        "contributionsCents"
      ],
      "properties": {
        "conceptCode": { "type": "string", "pattern": "^[0-9]{1,8}$" },
        "occurrences": { "$ref": "#/$defs/positiveInt32String" },
        "quantityHundredths": { "$ref": "#/$defs/nonNegativeInt64String" },
        "remunerativeCents": { "$ref": "#/$defs/int64String" },
        "nonRemunerativeCents": { "$ref": "#/$defs/int64String" },
        "familyAllowancesCents": { "$ref": "#/$defs/int64String" },
        "retentionsCents": { "$ref": "#/$defs/int64String" },
        "contributionsCents": { "$ref": "#/$defs/int64String" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "occurrences",
        "quantityHundredths",
        "remunerativeCents",
        "nonRemunerativeCents",
        "familyAllowancesCents",
        "retentionsCents",
        "contributionsCents",
        "netCents",
        "earningsPlusContributionsCents"
      ],
      "properties": {
        "occurrences": { "$ref": "#/$defs/nonNegativeInt64String" },
        "quantityHundredths": { "$ref": "#/$defs/nonNegativeInt64String" },
        "remunerativeCents": { "$ref": "#/$defs/int64String" },
        "nonRemunerativeCents": { "$ref": "#/$defs/int64String" },
        "familyAllowancesCents": { "$ref": "#/$defs/int64String" },
        "retentionsCents": { "$ref": "#/$defs/int64String" },
        "contributionsCents": { "$ref": "#/$defs/int64String" },
        "netCents": { "$ref": "#/$defs/int64String" },
        "earningsPlusContributionsCents": { "$ref": "#/$defs/int64String" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byteLength", "pageCount", "sourceLayout"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "byteLength": { "type": "integer", "minimum": 1, "maximum": 524288 },
        "pageCount": { "type": "integer", "minimum": 1, "maximum": 10 },
        "sourceLayout": { "const": "grh-concept-statistics-aggregate-by-concept" }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "jurisdiction", "conceptCount", "concepts", "totals", "source"],
      "properties": {
        "kind": { "enum": ["42", "55", "general"] },
        "jurisdiction": { "type": ["string", "null"], "pattern": "^(42|55)$" },
        "conceptCount": { "type": "integer", "minimum": 1, "maximum": 500 },
        "concepts": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "#/$defs/concept" } },
        "totals": { "$ref": "#/$defs/totals" },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "crossReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "equation",
        "toleranceCents",
        "conceptCount",
        "componentComparisons",
        "netDifferenceCents",
        "matches"
      ],
      "properties": {
        "equation": { "const": "jurisdiction_42 + jurisdiction_55 = general" },
        "toleranceCents": { "const": "0" },
        "conceptCount": { "type": "integer", "minimum": 1, "maximum": 500 },
        "componentComparisons": { "type": "integer", "minimum": 7, "maximum": 3500 },
        "netDifferenceCents": { "const": "0" },
        "matches": { "const": true }
      }
    }
  }
}
