 /* Scoped picker: real directory, visible selection and large touch targets. */
 .novelty-directory{width:min(1180px,96vw);max-width:96vw;max-height:92dvh;padding:0;border:1px solid #c5d9de;border-radius:18px;background:#f7fafb;color:#173d50;box-shadow:0 28px 90px #082c4540;font:14px/1.5 Arial,sans-serif;overflow:auto;animation:nd-in .18s ease-out}.novelty-directory::backdrop{background:#082d45a8;backdrop-filter:blur(3px)}.novelty-directory [hidden]{display:none!important}.nd-header{display:flex;align-items:center;justify-content:space-between;gap:20px;background:linear-gradient(110deg,#123c4d,#12665e);color:#fff;padding:22px 26px}.nd-header p{font-size:10px;letter-spacing:1.3px;margin:0;color:#bee9dc;font-weight:700}.nd-header h2{font-size:25px;margin:5px 0;letter-spacing:-.6px}.nd-header span{font-size:13px}.nd-header .button{color:#153d50;background:white;flex-shrink:0}.nd-content{padding:16px 24px}.nd-note{border-left:3px solid #0b847b;background:#eef7f4;padding:12px 14px;font-size:12px;margin:0 0 18px}.nd-filters{display:grid;grid-template-columns:1.7fr 1fr 1fr auto auto;gap:10px;align-items:end}.nd-filters label,.nd-sheet-fields label{display:flex;flex-direction:column;gap:6px;font-weight:700;font-size:12px;min-width:0}.novelty-directory input:not([type=checkbox]):not([type=radio]),.novelty-directory select{font:inherit;font-weight:400;min-height:44px;border:1px solid #b6cfd7;border-radius:8px;padding:10px;color:inherit;min-width:0;width:100%;box-sizing:border-box;background:#fff}.novelty-directory .button{font:700 12px/1.4 Arial,sans-serif;min-height:44px;cursor:pointer;border:1px solid #b2cbd1;border-radius:8px;padding:10px 14px;white-space:normal}.novelty-directory .button.primary{background:#087e77;color:#fff;border-color:#087e77}.novelty-directory button:disabled{opacity:.52;cursor:not-allowed}.novelty-directory :focus-visible{outline:3px solid #bd7f12;outline-offset:2px}#ndStatus{min-height:22px;font-size:12px;margin:15px 0}#ndError{background:#fff0eb;color:#a53124;padding:12px 14px;border-left:3px solid #ba462e;font-size:13px}.nd-layout{display:grid;grid-template-columns:minmax(0,1fr) 270px;gap:16px}.nd-results,.nd-basket{min-width:0;border:1px solid #d1e0e4;background:#fff;border-radius:12px;padding:14px}.nd-result-head{display:flex;align-items:center;justify-content:space-between;gap:10px}.nd-result-head strong{font-size:13px}.nd-cutoff{font-size:11px;color:#557383}.nd-table-wrap{overflow:auto;max-height:355px;border:1px solid #e1eaee;border-radius:8px}.nd-table-wrap table{border-collapse:collapse;width:100%;font-size:12px}.nd-table-wrap th{position:sticky;top:0;text-align:left;background:#eaf2f5;padding:10px 9px;font-size:10px;text-transform:uppercase;z-index:1}.nd-table-wrap td{padding:10px 9px;border-bottom:1px solid #e1eaee;vertical-align:middle}.nd-table-wrap label{display:block;cursor:pointer}.nd-table-wrap strong,.nd-table-wrap label span{display:block}.nd-table-wrap label span{color:#577385;margin-top:3px}.nd-table-wrap small{display:block;color:#617783;font-size:10px;margin-top:4px}.novelty-directory input[type=checkbox],.novelty-directory input[type=radio]{width:20px;height:20px;accent-color:#087e77;cursor:pointer;margin:8px}.nd-existing{color:#966014!important}.nd-table-wrap tr:has(input:checked){background:#eaf7f1}.nd-basket h3{font-size:16px;margin:0 0 8px}.nd-basket h3 span{background:#087e77;color:#fff;font-size:12px;padding:3px 9px;border-radius:20px;margin-left:6px}.nd-basket>p{font-size:11px;color:#547184}.nd-basket #ndSelected{max-height:315px;overflow:auto;margin:14px 0}.nd-person{display:flex;align-items:center;gap:7px;justify-content:space-between;padding:9px 0;border-bottom:1px solid #e3ecee}.nd-person strong{font-size:11px;display:block;overflow-wrap:anywhere}.nd-person span{font-size:10px;display:block;color:#547184}.nd-person .button{padding:7px;min-height:40px;font-size:10px;flex-shrink:0}.nd-empty-selection{font-size:12px;color:#6f8390;padding:20px 0}.nd-pager{display:flex;align-items:center;justify-content:center;gap:12px;margin-top:14px}.nd-pager span{font-size:11px}.nd-footer{position:sticky;bottom:0;background:#edf6f4;border-top:1px solid #c2d9d5;padding:16px 24px;display:flex;gap:18px;align-items:center;justify-content:space-between}.nd-footer p{font-size:12px;margin:0}.nd-footer button{min-width:170px}.nd-sheet-fields{display:grid;grid-template-columns:1fr 1fr 1.5fr;gap:15px;align-items:end;border:1px solid #cfe0df;border-radius:12px;margin:16px 0 0;padding:16px;background:#fff}.nd-sheet-fields p{font-size:11px;margin:0}.nd-open-button{margin-top:8px;width:100%}@keyframes nd-in{from{opacity:.55;transform:translateY(7px)}to{opacity:1;transform:none}}@media(max-width:880px){.nd-filters{grid-template-columns:1fr 1fr}.nd-filters label:first-child{grid-column:1/-1}.nd-layout{grid-template-columns:1fr}.nd-basket #ndSelected{max-height:140px}.nd-sheet-fields{grid-template-columns:1fr 1fr}.nd-sheet-fields p{grid-column:1/-1}}@media(max-width:520px){.novelty-directory{max-width:98vw;width:98vw;max-height:96dvh;border-radius:12px}.nd-header{padding:16px;gap:8px}.nd-header h2{font-size:20px}.nd-header span{font-size:11px}.nd-content{padding:12px}.nd-layout{gap:10px}.nd-filters{gap:8px}.nd-results,.nd-basket{padding:10px}.nd-table-wrap th:nth-child(3),.nd-table-wrap td:nth-child(3){display:none}.nd-result-head{align-items:start}.nd-result-head button{max-width:140px}.nd-footer{padding:12px;display:block}.nd-footer button{width:100%;margin-top:9px}.nd-pager{gap:8px}.nd-basket #ndSelected{max-height:130px}}@media(prefers-reduced-motion:reduce){.novelty-directory{animation:none}.novelty-directory *{scroll-behavior:auto!important}}
