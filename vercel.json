    { "source": "/importar", "destination": "/datos-personales.html" },
    { "source": "/upload", "destination": "/datos-personales.html" },
    { "source": "/ingest", "destination": "/datos-personales.html" },
    { "source": "/admin", "destination": "/internal-dashboard.html" },
    { "source": "/auditoria", "destination": "/datos-personales.html" },

    { "source": "/", "destination": "/friendly-dashboard.html" },
    { "source": "/dashboard", "destination": "/friendly-dashboard.html" },
    { "source": "/inicio", "destination": "/friendly-dashboard.html" },
    { "source": "/index-loaded", "destination": "/friendly-dashboard.html" },
    { "source": "/afip", "destination": "/friendly-dashboard.html" },
    { "source": "/analytics", "destination": "/reportes-rrhh.html" },
