    { "source": "/api/ai-proxy", "destination": "/api/friendly-policy" },
    { "source": "/api/audit", "destination": "/api/friendly-policy" },
    { "source": "/api/auth-email", "destination": "/api/friendly-policy" },
    { "source": "/api/auth/login", "destination": "/api/friendly-policy" },
