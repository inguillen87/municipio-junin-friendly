    { "source": "/api/whatsapp-alert", "destination": "/api/friendly-policy" },
    { "source": "/api/whatsapp-test", "destination": "/api/friendly-policy" },
    { "source": "/api/whatsapp-vecinos", "destination": "/api/friendly-policy" },
    { "source": "/api/whatsapp-voice", "destination": "/api/friendly-policy" },
    { "source": "/api/whatsapp-webhook", "destination": "/api/friendly-policy" },
    { "source": "/rrhh-data/:path*", "destination": "/api/friendly-policy" },

    { "source": "/login", "destination": "/login.html" },
    { "source": "/internal", "destination": "/internal-dashboard.html" },
    { "source": "/internal-dashboard", "destination": "/internal-dashboard.html" },
    { "source": "/modulos", "destination": "/modulos.html" },
    { "source": "/reportes-rrhh", "destination": "/reportes-rrhh.html" },
    { "source": "/calidad-datos", "destination": "/calidad-datos.html" },
    { "source": "/estructura", "destination": "/estructura.html" },
    { "source": "/integracion-datos", "destination": "/integracion-datos.html" },
    { "source": "/nomina-control", "destination": "/nomina-control.html" },
    { "source": "/ausentismo-control", "destination": "/ausentismo-control.html" },
    { "source": "/calidad-operativa", "destination": "/calidad-operativa.html" },
    { "source": "/asistente", "destination": "/asistente.html" },
    { "source": "/centro-ayuda", "destination": "/centro-ayuda.html" },
    { "source": "/ayuda", "destination": "/centro-ayuda.html" },

    { "source": "/rrhh", "destination": "/internal-dashboard.html" },
    { "source": "/rrhh-sync", "destination": "/datos-personales.html" },
    { "source": "/hacienda", "destination": "/friendly-dashboard.html?section=hacienda" },
    { "source": "/ia", "destination": "/asistente.html" },
    { "source": "/ia-hf", "destination": "/asistente.html" },
    { "source": "/inteligencia", "destination": "/reportes-rrhh.html" },
    { "source": "/reportes", "destination": "/reportes-rrhh.html" },
