    { "source": "/control", "destination": "/friendly-dashboard.html" },
    { "source": "/cuentas-claras", "destination": "/friendly-dashboard.html" },
    { "source": "/expedientes", "destination": "/friendly-dashboard.html" },
    { "source": "/form-public", "destination": "/friendly-dashboard.html" },
    { "source": "/forms", "destination": "/friendly-dashboard.html" },
    { "source": "/informe-rrhh", "destination": "/reportes-rrhh.html" },
    { "source": "/licitaciones", "destination": "/friendly-dashboard.html?section=compras" },
    { "source": "/manuales", "destination": "/modulos.html" },
    { "source": "/mapa", "destination": "/modulos.html" },
    { "source": "/obras", "destination": "/modulos.html" },
    { "source": "/organigrama", "destination": "/estructura.html" },
    { "source": "/presentacion", "destination": "/friendly-dashboard.html" },
    { "source": "/presupuesto", "destination": "/friendly-dashboard.html?section=hacienda" },
    { "source": "/proveedores", "destination": "/friendly-dashboard.html?section=compras" },
    { "source": "/servicios", "destination": "/friendly-dashboard.html?section=servicios" },
    { "source": "/talleres", "destination": "/friendly-dashboard.html?section=servicios" },
    { "source": "/vecinos", "destination": "/modulos.html" },
    { "source": "/whatsapp", "destination": "/modulos.html" }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Cache-Control", "value": "public, no-cache, no-store, must-revalidate" },
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" },
        { "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }
      ]
    },
    {
      "source": "/assets/pwa/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/rrhh-data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "private, no-store, max-age=0" }]
    },
